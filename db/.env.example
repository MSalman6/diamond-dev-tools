# Template for db/.env (the docker compose variable source for db/docker-compose*.yml).
# Copy to db/.env and fill with strong, unique values. db/.env is gitignored — never commit it.

# Postgres superuser password (used by the postgres container + migrations).
export DMD_DB_POSTGRES=postgres
export DMD_DB_POSTGRES_PASS=change-me-to-a-strong-password
export DMD_DB_POSTGRES_PORT=5433
export DMD_DB_POSTGRES_HOST=127.0.0.1
export POSTGRES_INSTANCE=127.0.0.1:5433

# pgAdmin login password — must be different from DMD_DB_POSTGRES_PASS.
export DMD_PGADMIN_PASS=change-me-to-a-different-strong-password

export RPC_URL=http://localhost:54100/
export RPC_URL_DOCKER=http://host.docker.internal:54100/
export HOST=localhost
export PORT=4000
export DEV_TOOLS_LOG_DEBUG=false
